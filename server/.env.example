PORT=5001
NODE_ENV=development
BACKEND_URL=http://localhost:5001

# Railway: automatically set by Railway to the service's public domain (e.g. lumo-backend-xxxx.up.railway.app)
# RAILWAY_PUBLIC_DOMAIN=

# Railway: Use DATABASE_URL instead of individual DB_* vars
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# PostgreSQL Configuration (ignored if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumo_db
DB_USER=postgres
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=30d

# Client URL – set to the deployed frontend URL in production
# (e.g. https://lumo-frontend-xxxx.up.railway.app)
CLIENT_URL=http://localhost:5173

# AI Configuration (Ollama/Deepseek)
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Lumo <noreply@lumo.app>
FRONTEND_URL=http://localhost:3000

# Cloudinary (Stockage images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Railway: Use REDIS_URL instead of individual REDIS_* vars
# REDIS_URL=redis://default:password@host:6379

# Production: explicit frontend/backend HTTPS origins (comma-separated additional origins).
# LUMO_ALLOWED_ORIGINS=https://staging.example.com
# LUMO_BACKUP_KEY_HEX=64 hex characters generated securely and stored separately
# LUMO_CONTACT_EMAIL=contact@example.com
# LUMO_PUBLIC_AI_ENABLED=false
# LUMO_ALERT_CRON=false

# Public Swagger UI is disabled in production unless explicitly enabled.
# LUMO_PUBLIC_API_DOCS=false

# Optional versioned backup keyring. Store values in the deployment secret manager only.
# LUMO_BACKUP_ACTIVE_KEY_ID=key-2026-01
# LUMO_BACKUP_KEYS_JSON=<JSON object mapping key IDs to 64-character hex secrets>
# Keep LUMO_BACKUP_KEY_HEX unchanged for pre-keyring archives until verified retirement.

# Explicit opt-in to send private aggregate metrics and question text to configured AI provider.
# LUMO_PRIVATE_AI_ENABLED=false
# LUMO_EMAIL_PROVIDER=smtp or resend (no automatic retry via another provider)
