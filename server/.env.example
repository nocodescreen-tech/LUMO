PORT=5001
NODE_ENV=development
BACKEND_URL=http://localhost:5001

# Railway: Use DATABASE_URL instead of individual DB_* vars
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# PostgreSQL Configuration (ignored if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumo_db
DB_USER=postgres
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=30d

# Client URL (utilisé dans les templates email)
CLIENT_URL=http://localhost:5173

# AI Configuration (Ollama/Deepseek)
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Lumo <noreply@lumo.app>
FRONTEND_URL=http://localhost:3000

# Cloudinary (Stockage images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Railway: Use REDIS_URL instead of individual REDIS_* vars
# REDIS_URL=redis://default:password@host:6379
