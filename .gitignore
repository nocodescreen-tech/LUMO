# ============================================================
# LUMO ERP - .gitignore
# ============================================================

# ─── Dépendances ─────────────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/
doc/
# ─── Variables d'environnement (SECRETS) ─────────────────────
.env
.env.*
client/.env
client/.env.*
server/.env
server/.env.*

# ─── Builds & Compilations ───────────────────────────────────
dist/
build/
client/dist/
client/build/
server/dist/

# ─── Cache Vite / Typescript / Eslint ────────────────────────
.vite/
client/.vite/
*.tsbuildinfo
.eslintcache
.cache/
.parcel-cache/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# ─── Clés et certificats sensibles ───────────────────────────
server/config/*firebase*.json
server/config/*service*.json
*.pem
*.key
*.cert

# ─── Sauvegardes serveur ─────────────────────────────────────
server/backups/

# ─── Dossiers temporaires / scripts one-shot ─────────────────
scratch/
LUMO_TEMP/
LUMO_SOURCE/

# ─── Fichiers de scripts one-shot (racine) ───────────────────
replace_hubcommerce.js
patch_settings.js

# ─── Documents d'analyse temporaires ─────────────────────────
ANALYSE_COMPLETE_HUBCOMMERCE.md
ANALYSE_SETTINGS_HUBCOMMERCE.md
CHAPITRE_2_LUMO.md

# ─── Outils IA / agents (répertoires IDE) ────────────────────
.agent/
.autoclaw/
.kilocode/
.clinerules/
.kilocodemodes

# ─── OS & Éditeurs ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ─── Tests & Couverture ──────────────────────────────────────
coverage/
.nyc_output/

# ─── Docker (volumes locaux) ─────────────────────────────────
.docker/

# ─── Divers ──────────────────────────────────────────────────
*.bak
*.gitignore.bak