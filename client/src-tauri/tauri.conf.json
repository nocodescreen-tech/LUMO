{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LUMO",
  "version": "1.0.0",
  "identifier": "com.nocodescreen.lumo",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 5180",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LUMO",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Business",
    "shortDescription": "LUMO - Solution ERP pour commerçants",
    "longDescription": "LUMO Pro : gestion commerciale complète (ventes, stocks, clients, équipe). Connecté à votre base de production.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["French", "English"]
      }
    }
  }
}
